{
  "name": "fedora-agents-mcp",
  "version": "1.0.0",
  "description": "MCP Server for VM-Controller and Backup-Manager agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/amineutron/fedora-agents.git"
  },
  "homepage": "https://github.com/amineutron/fedora-agents",
  "keywords": [
    "mcp",
    "mcp-server",
    "kvm",
    "libvirt",
    "borgbackup",
    "timeshift",
    "fedora",
    "devops"
  ],
  "type": "module",
  "main": "dist/index.js",
