{
  "name": "fedora-agents-mcp",
  "version": "1.3.0",
  "mcpName": "io.github.amineutron/fedora-agents",
  "description": "Local-first, self-hosted MCP server for KVM/libvirt VMs and Borg/Timeshift backups on Fedora, built for LLM agents (audit log, per-script sudoers)",
  "repository": {
    "type": "git",
    "url": "https://github.com/amineutron/fedora-agents.git"
  },
  "homepage": "https://github.com/amineutron/fedora-agents",
  "keywords": [
    "mcp",
    "mcp-server",
    "kvm",
    "libvirt",
    "borgbackup",
    "timeshift",
    "fedora",
    "devops",
    "local-first",
    "self-hosted",
    "on-prem"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fedora-agents-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "node --test",
    "lint": "biome lint --error-on-warnings",
    "security:table": "node scripts/gen-security-table.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "amineutron",
  "license": "MIT"
}
